# Entorno 100% LOCAL para `npm run dev:all`. Sin secretos: solo apunta a la base de la Mac.
# El script carga este archivo y lo impone sobre .env / .env.local, así nunca se usa data real.
DATABASE_URL="postgresql://omero@127.0.0.1:5434/omero-finance"
DATABASE_URL_UNPOOLED="postgresql://omero@127.0.0.1:5434/omero-finance"
AUTH_SECRET="dev-local-secret"
NEXTAUTH_URL="http://localhost:3001"
# Cambiar a "true" para probar el modo en que toda operación exige cuenta.
ACCOUNT_REQUIRED="false"
