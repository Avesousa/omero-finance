{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://omero-finance.vercel.app",
        "EXPO_PUBLIC_DATA_SOURCE": "api",
        "EXPO_PUBLIC_VOICE_SOURCE": "api"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://omero-finance.vercel.app",
        "EXPO_PUBLIC_DATA_SOURCE": "api",
        "EXPO_PUBLIC_VOICE_SOURCE": "api"
      }
    }
  },
  "submit": { "production": {} }
}
