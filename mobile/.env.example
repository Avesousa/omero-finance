# URL de la web de Omero (el backend). Sin barra al final.
# En producción:
EXPO_PUBLIC_API_URL=https://<tu-app>.vercel.app
# Para probar en local, usá la IP de tu compu en la red (no localhost: el teléfono no la ve):
# EXPO_PUBLIC_API_URL=http://<IP de tu compu>:3000

# De dónde salen los datos: mock (ejemplos, por defecto) o api (el backend real)
EXPO_PUBLIC_DATA_SOURCE=mock
