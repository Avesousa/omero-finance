# URL de la web de Omero (el backend). Sin barra al final.
# En producción:
EXPO_PUBLIC_API_URL=https://<tu-app>.vercel.app
# Para probar en local, usá la IP de tu compu en la red (no localhost: el teléfono no la ve):
# EXPO_PUBLIC_API_URL=http://<IP de tu compu>:3000

# De dónde salen los datos: mock (ejemplos, por defecto) o api (el backend real)
# Para usar la app con tus datos reales: api (y EXPO_PUBLIC_API_URL con la URL de producción).
EXPO_PUBLIC_DATA_SOURCE=mock

# De dónde sale la voz: api o mock. Si no lo ponés, sigue a EXPO_PUBLIC_DATA_SOURCE.
# Para probar la voz real (OpenAI) con el resto en mock, sin escribir nada en la base:
#   # Para usar la app con tus datos reales: api (y EXPO_PUBLIC_API_URL con la URL de producción).
EXPO_PUBLIC_DATA_SOURCE=mock  +  EXPO_PUBLIC_VOICE_SOURCE=api  (pide login y EXPO_PUBLIC_API_URL)
# EXPO_PUBLIC_VOICE_SOURCE=api
