// Omero Finance — Prisma Schema v1.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────

model Household {
  id        String        @id @default(cuid())
  name      String
  type      HouseholdType @default(PERSONAL)
  createdAt DateTime      @default(now())

  users             User[]
  invitations       HouseholdInvitation[]
  incomes           Income[]
  creditCards       CreditCardStatement[]
  cards             Card[]
  fixedTemplates    FixedExpenseTemplate[]
  fixedExpenses     FixedExpense[]
  groceries         GroceryExpense[]
  householdExpenses HouseholdExpense[]
  personalExpenses  PersonalExpense[]
  rentPayments      RentPayment[]
  savings           Saving[]
  loans             Loan[]
  debts             Debt[]
  mpMovements       MercadoPagoMovement[]
  budgetConfigs     BudgetConfig[]
  exchangeRates     ExchangeRate[]
  accounts          Account[]
  accountTransfers  AccountTransfer[]

  // Plan simple (/plan)
  planMonths         PlanMonth[]
  planCategories     PlanCategory[]
  planRecurrings     PlanRecurring[]
  planEntries        PlanEntry[]
  planBudgets        PlanBudget[]
  planCardPurchases  PlanCardPurchase[]
  planCardStatements PlanCardStatement[]
  planBalanceItems   PlanBalanceItem[]
  planLoans          PlanLoan[]
}

model User {
  id           String   @id @default(cuid())
  householdId  String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MEMBER)
  avatarColor  String   @default("#6366F1")
  createdAt    DateTime @default(now())

  household               Household             @relation(fields: [householdId], references: [id])
  sessions                Session[]
  incomesCreated          Income[]              @relation("IncomeCreatedBy")
  creditCardsCreated      CreditCardStatement[] @relation("CardCreatedBy")
  fixedExpensesCreated    FixedExpense[]        @relation("FixedCreatedBy")
  groceriesCreated        GroceryExpense[]      @relation("GroceryCreatedBy")
  householdExpCreated     HouseholdExpense[]    @relation("HouseholdExpCreatedBy")
  personalExpOwned        PersonalExpense[]     @relation("PersonalExpOwner")
  personalExpCreated      PersonalExpense[]     @relation("PersonalExpCreatedBy")
  rentCreated             RentPayment[]         @relation("RentCreatedBy")
  savingsCreated          Saving[]              @relation("SavingCreatedBy")
  loansOwned              Loan[]                @relation("LoanOwner")
  loansCreated            Loan[]                @relation("LoanCreatedBy")
  debtsCreated            Debt[]                @relation("DebtCreatedBy")
  mpMovementsCategorized  MercadoPagoMovement[] @relation("MPCategorizedBy")
  accounts                Account[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Income
// ─────────────────────────────────────────────

model Income {
  id                 String     @id @default(cuid())
  householdId        String
  createdById        String
  month              String
  year               Int
  type               IncomeType
  currency           Currency   @default(ARS)
  amount             Decimal    @db.Decimal(14, 2)
  amountArs          Decimal?   @db.Decimal(14, 2)
  dollarRateSnapshot Decimal?   @db.Decimal(10, 4)
  description        String?
  isPersonal         Boolean    @default(false)
  createdAt          DateTime   @default(now())

  household Household @relation(fields: [householdId], references: [id])
  createdBy User      @relation("IncomeCreatedBy", fields: [createdById], references: [id])
}

// ─────────────────────────────────────────────
// Credit Cards
// ─────────────────────────────────────────────

model CreditCardStatement {
  id                 String   @id @default(cuid())
  householdId        String
  createdById        String
  month              String
  year               Int
  cardName           String
  ownerUserId        String?
  dueDate            DateTime
  minimumPayment     Decimal? @db.Decimal(14, 2)
  totalAmountArs     Decimal  @db.Decimal(14, 2)
  usdAmount          Decimal? @db.Decimal(14, 2)
  dollarRateSnapshot Decimal? @db.Decimal(10, 4)
  customAmount       Decimal? @db.Decimal(14, 2)
  amountToPay        Decimal  @db.Decimal(14, 2)
  payMinimum         Boolean   @default(false)
  committedOverride  Decimal?  @db.Decimal(14, 2)
  isPaid             Boolean   @default(false)
  paidAt             DateTime?
  paymentSource      String?
  createdAt          DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id])
  createdBy User      @relation("CardCreatedBy", fields: [createdById], references: [id])
}

// ─────────────────────────────────────────────
// Fixed Expense Templates (recurring catalog)
// ─────────────────────────────────────────────

model FixedExpenseTemplate {
  id          String   @id @default(cuid())
  householdId String
  concept     String
  currency    Currency @default(ARS)
  amount      Decimal  @db.Decimal(14, 2)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])
}

// ─────────────────────────────────────────────
// Cards catalog
// ─────────────────────────────────────────────

model Card {
  id          String   @id @default(cuid())
  householdId String
  name        String
  entity      String?
  cardType    String?
  ownerName   String?
  createdAt   DateTime @default(now())

  household      Household           @relation(fields: [householdId], references: [id])
  planPurchases  PlanCardPurchase[]
  planStatements PlanCardStatement[]
}

// ─────────────────────────────────────────────
// Fixed Expenses
// ─────────────────────────────────────────────

model FixedExpense {
  id                 String   @id @default(cuid())
  householdId        String
  createdById        String
  concept            String
  subcategory        String?
  currency           Currency @default(ARS)
  amount             Decimal  @db.Decimal(14, 2)
  amountArs          Decimal? @db.Decimal(14, 2)
  dollarRateSnapshot Decimal? @db.Decimal(10, 4)
  isPaid             Boolean  @default(false)
  month              String
  year               Int
  createdAt          DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])
  createdBy User      @relation("FixedCreatedBy", fields: [createdById], references: [id])
}

// ─────────────────────────────────────────────
// Grocery Expenses
// ─────────────────────────────────────────────

model GroceryExpense {
  id                 String   @id @default(cuid())
  householdId        String
  createdById        String
  month              String
  year               Int
  description        String
  cardName           String?
  currency           Currency @default(ARS)
  amount             Decimal  @db.Decimal(14, 2)
  amountArs          Decimal? @db.Decimal(14, 2)
  dollarRateSnapshot Decimal? @db.Decimal(10, 4)
  createdAt          DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])
  createdBy User      @relation("GroceryCreatedBy", fields: [createdById], references: [id])
}

// ─────────────────────────────────────────────
// Household General Expenses
// ─────────────────────────────────────────────

model HouseholdExpense {
  id                 String      @id @default(cuid())
  householdId        String
  createdById        String
  month              String
  year               Int
  description        String
  cardName           String?
  expenseType        ExpenseType @default(UNNECESSARY)
  currency           Currency    @default(ARS)
  amount             Decimal     @db.Decimal(14, 2)
  amountArs          Decimal?    @db.Decimal(14, 2)
  dollarRateSnapshot Decimal?    @db.Decimal(10, 4)
  createdAt          DateTime    @default(now())

  household Household @relation(fields: [householdId], references: [id])
  createdBy User      @relation("HouseholdExpCreatedBy", fields: [createdById], references: [id])
}

// ─────────────────────────────────────────────
// Personal Expenses
// ─────────────────────────────────────────────

model PersonalExpense {
  id                 String   @id @default(cuid())
  householdId        String
  userId             String
  createdById        String
  month              String
  year               Int
  concept            String
  cardName           String?
  currency           Currency @default(ARS)
  amount             Decimal  @db.Decimal(14, 2)
  amountArs          Decimal? @db.Decimal(14, 2)
  dollarRateSnapshot Decimal? @db.Decimal(10, 4)
  isPaid             Boolean  @default(true)
  createdAt          DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])
  owner     User      @relation("PersonalExpOwner", fields: [userId], references: [id])
  createdBy User      @relation("PersonalExpCreatedBy", fields: [createdById], references: [id])
}

// ─────────────────────────────────────────────
// Rent & Building Fees
// ─────────────────────────────────────────────

model RentPayment {
  id                 String   @id @default(cuid())
  householdId        String
  createdById        String
  month              String
  year               Int
  type               RentType
  apartment          String
  currency           Currency @default(ARS)
  amount             Decimal  @db.Decimal(14, 2)
  amountArs          Decimal? @db.Decimal(14, 2)
  dollarRateSnapshot Decimal? @db.Decimal(10, 4)
  description        String?
  cbuAlias           String?
  createdAt          DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])
  createdBy User      @relation("RentCreatedBy", fields: [createdById], references: [id])
}

// ─────────────────────────────────────────────
// Savings & Investments
// ─────────────────────────────────────────────

model Saving {
  id                 String     @id @default(cuid())
  householdId        String
  createdById        String
  date               DateTime
  description        String
  type               SavingType
  currency           Currency   @default(ARS)
  amount             Decimal    @db.Decimal(14, 2)
  amountArs          Decimal?   @db.Decimal(14, 2)
  dollarRateSnapshot Decimal?   @db.Decimal(10, 4)
  platform           String?
  createdAt          DateTime   @default(now())

  household Household @relation(fields: [householdId], references: [id])
  createdBy User      @relation("SavingCreatedBy", fields: [createdById], references: [id])
}

// ─────────────────────────────────────────────
// Loans
// ─────────────────────────────────────────────

model Loan {
  id                 String          @id @default(cuid())
  householdId        String
  ownerUserId        String
  createdById        String
  direction          LoanDirection
  counterpart        String
  paymentMethod      String?
  currency           Currency        @default(ARS)
  principal          Decimal         @db.Decimal(14, 2)
  principalArs       Decimal?        @db.Decimal(14, 2)
  dollarRateSnapshot Decimal?        @db.Decimal(10, 4)
  installments       Int
  installmentUnit    InstallmentUnit @default(MONTHLY)
  interestRate       Decimal         @db.Decimal(6, 4)
  totalAmount        Decimal         @db.Decimal(14, 2)
  notes              String?
  createdAt          DateTime        @default(now())

  household          Household        @relation(fields: [householdId], references: [id])
  owner              User             @relation("LoanOwner", fields: [ownerUserId], references: [id])
  createdBy          User             @relation("LoanCreatedBy", fields: [createdById], references: [id])
  installmentRecords LoanInstallment[]
}

model LoanInstallment {
  id                String   @id @default(cuid())
  loanId            String
  installmentNumber Int
  dueDate           DateTime
  amount            Decimal  @db.Decimal(14, 2)
  currency          Currency @default(ARS)
  isPaid            Boolean  @default(false)
  paidDate          DateTime?

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Debts to collect
// ─────────────────────────────────────────────

model Debt {
  id                 String     @id @default(cuid())
  householdId        String
  createdById        String
  date               DateTime
  concept            String
  debtor             String
  currency           Currency   @default(ARS)
  totalAmount        Decimal    @db.Decimal(14, 2)
  totalArs           Decimal?   @db.Decimal(14, 2)
  dollarRateSnapshot Decimal?   @db.Decimal(10, 4)
  amountPaid         Decimal    @default(0) @db.Decimal(14, 2)
  status             DebtStatus @default(ACTIVE)
  createdAt          DateTime   @default(now())

  household Household @relation(fields: [householdId], references: [id])
  createdBy User      @relation("DebtCreatedBy", fields: [createdById], references: [id])
}

// ─────────────────────────────────────────────
// MercadoPago
// ─────────────────────────────────────────────

model MercadoPagoMovement {
  id              String           @id @default(cuid())
  householdId     String
  mpReferenceId   String           @unique
  releaseDate     DateTime
  transactionType String
  netAmount       Decimal          @db.Decimal(14, 2)
  partialBalance  Decimal?         @db.Decimal(14, 2)
  currency        Currency         @default(ARS)
  status          MPMovementStatus @default(PENDING)
  category        String?
  subCategory     String?
  linkedExpenseId String?
  notes           String?
  categorizedById String?
  syncedAt        DateTime         @default(now())

  household     Household @relation(fields: [householdId], references: [id])
  categorizedBy User?     @relation("MPCategorizedBy", fields: [categorizedById], references: [id])
}

// ─────────────────────────────────────────────
// Budget Config
// ─────────────────────────────────────────────

model BudgetConfig {
  id               String         @id @default(cuid())
  householdId      String
  month            String
  year             Int
  category         BudgetCategory
  manualPercentage Decimal?       @db.Decimal(6, 4)
  manualAmount     Decimal?       @db.Decimal(14, 2)
  manualCurrency   Currency       @default(ARS)
  isReserved       Boolean        @default(true)

  household Household @relation(fields: [householdId], references: [id])

  @@unique([householdId, month, year, category])
}

// ─────────────────────────────────────────────
// Exchange Rate
// ─────────────────────────────────────────────

model ExchangeRate {
  id          String     @id @default(cuid())
  householdId String?
  date        DateTime   @unique
  usdArs      Decimal    @db.Decimal(10, 4)
  source      RateSource @default(API)

  household Household? @relation(fields: [householdId], references: [id])
}

// ─────────────────────────────────────────────
// Accounts
// ─────────────────────────────────────────────

model Account {
  id          String      @id @default(cuid())
  householdId String
  userId      String?
  name        String
  type        AccountType @default(CHECKING)
  currency    Currency    @default(ARS)
  balance     Decimal     @default(0) @db.Decimal(14, 2)
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())

  household     Household        @relation(fields: [householdId], references: [id])
  user          User?            @relation(fields: [userId], references: [id])
  transfersFrom AccountTransfer[] @relation("TransferFrom")
  transfersTo   AccountTransfer[] @relation("TransferTo")
}

model AccountTransfer {
  id            String   @id @default(cuid())
  householdId   String
  fromAccountId String
  toAccountId   String
  amount        Decimal  @db.Decimal(14, 2)
  currency      Currency @default(ARS)
  description   String?
  createdAt     DateTime @default(now())

  household   Household @relation(fields: [householdId], references: [id])
  fromAccount Account   @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   Account   @relation("TransferTo",   fields: [toAccountId],   references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  MEMBER
}

enum Currency {
  ARS
  USD
}

enum IncomeType {
  SUELDO
  FREELANCE
  AHORROS
  PAGO_DEUDA
  REMANENTES
  PRESTAMO
  INVERSION
}

enum ExpenseType {
  NECESSARY
  UNNECESSARY
}

enum RentType {
  ALQUILER
  EXPENSAS
  TRABAJOS
}

enum SavingType {
  AHORRO
  VIAJE
  INVERSION
}

enum LoanDirection {
  DADO
  TOMADO
}

enum InstallmentUnit {
  WEEKLY
  MONTHLY
}

enum DebtStatus {
  ACTIVE
  SETTLED
}

enum MPMovementStatus {
  PENDING
  CATEGORIZED
}

enum BudgetCategory {
  ALQUILER
  TDC
  GASTOS_FIJOS
  MERCADO
  GASTOS_LIBRES
  AHORRO_CASA
  AHORRO_VACACIONES
  INVERSION_AHORRO
  OTROS
}

enum RateSource {
  API
  MANUAL
}

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  CASH
  DIGITAL
}

enum HouseholdType {
  PERSONAL
  SHARED
  ORGANIZATION
  MULTIPLE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// ─────────────────────────────────────────────
// Household Invitations (for SHARED households)
// ─────────────────────────────────────────────

model HouseholdInvitation {
  id          String           @id @default(cuid())
  householdId String
  email       String?
  code        String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  household Household @relation(fields: [householdId], references: [id])
}

// ═════════════════════════════════════════════
// Plan simple (/plan)
// Tablas nuevas e independientes del resto de la app.
// El mes se guarda como "YYYY-MM" en `period`.
// ═════════════════════════════════════════════

enum PlanKind {
  INCOME
  EXPENSE
}

enum PlanFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PlanPayMode {
  TOTAL
  MINIMUM
  CUSTOM
}

enum PlanBalanceType {
  ASSET
  DEBT
}

/// OWE = lo debo yo (gasto) · OWED = me lo deben (ingreso).
enum PlanLoanDirection {
  OWE
  OWED
}

/// FIXED = cuota fija × N · SCHEDULE = cuotas cargadas a mano · OPEN = saldo sin cuotas fijas.
enum PlanLoanMode {
  FIXED
  SCHEDULE
  OPEN
}

/// Un mes "iniciado": guarda el tipo de cambio usado para ese mes.
model PlanMonth {
  id          String   @id @default(cuid())
  householdId String
  period      String
  usdRate     Decimal  @db.Decimal(10, 4)
  startedAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])

  @@unique([householdId, period])
}

/// Categorías de ingresos y de gastos. `systemKey = "TDC"` es la línea de
/// tarjetas de crédito: su gasto real sale de los resúmenes, no de movimientos.
model PlanCategory {
  id          String   @id @default(cuid())
  householdId String
  kind        PlanKind
  name        String
  systemKey   String?
  isArchived  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  household       Household          @relation(fields: [householdId], references: [id])
  recurrings      PlanRecurring[]    @relation("PlanRecurringCategory")
  recurringTarget PlanRecurring[]    @relation("PlanRecurringTarget")
  entries         PlanEntry[]        @relation("PlanEntryCategory")
  entryTarget     PlanEntry[]        @relation("PlanEntryTarget")
  budgets         PlanBudget[]
  cardPurchases   PlanCardPurchase[]
  loans           PlanLoan[]

  @@unique([householdId, kind, name])
}

/// La "regla" de un ingreso fijo o gasto fijo: monto por vez + recurrencia.
/// Cada mes genera un PlanEntry (monto × cantidad de veces en el mes).
model PlanRecurring {
  id               String        @id @default(cuid())
  householdId      String
  kind             PlanKind
  name             String
  categoryId       String?
  /// Solo ingresos: categoría de gasto a la que se destina (opcional).
  targetCategoryId String?
  currency         Currency      @default(ARS)
  /// Monto por ocurrencia (por día, por semana, por quincena o por mes).
  amount           Decimal       @db.Decimal(14, 2)
  frequency        PlanFrequency @default(MONTHLY)
  /// Semanal: día de la semana (0 = domingo … 6 = sábado).
  weekday          Int?
  /// Mensual: día del mes en que se cobra / vence (informativo).
  dueDay           Int?
  isActive         Boolean       @default(true)
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())

  household      Household     @relation(fields: [householdId], references: [id])
  category       PlanCategory? @relation("PlanRecurringCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  targetCategory PlanCategory? @relation("PlanRecurringTarget", fields: [targetCategoryId], references: [id], onDelete: SetNull)
  entries        PlanEntry[]

  @@index([householdId, kind])
}

/// Un ingreso o gasto de un mes. Si `recurringId` está presente es un fijo
/// (generado desde la regla); si no, es un movimiento variable.
model PlanEntry {
  id               String    @id @default(cuid())
  householdId      String
  period           String
  kind             PlanKind
  recurringId      String?
  name             String
  categoryId       String?
  targetCategoryId String?
  currency         Currency  @default(ARS)
  amount           Decimal   @db.Decimal(14, 2)
  date             DateTime? @db.Date
  /// Fijos: cobrado / pagado.
  isDone           Boolean   @default(false)
  note             String?
  /// Cuota de un préstamo o deuda (PlanLoan). Uno por préstamo y mes.
  loanId           String?
  /// Parte del monto que es interés (calculado al generar la cuota).
  interestAmount   Decimal?  @db.Decimal(14, 2)
  createdAt        DateTime  @default(now())

  household      Household      @relation(fields: [householdId], references: [id])
  loan           PlanLoan?      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  recurring      PlanRecurring? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  category       PlanCategory?  @relation("PlanEntryCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  targetCategory PlanCategory?  @relation("PlanEntryTarget", fields: [targetCategoryId], references: [id], onDelete: SetNull)

  @@unique([recurringId, period])
  @@unique([loanId, period])
  @@index([householdId, period])
}

/// Préstamo o deuda: lo que debo o lo que me deben.
/// Cada mes iniciado genera un PlanEntry (la cuota) vinculado por `loanId`;
/// al marcar pagadas todas las cuotas (o saldar el saldo) se cierra solo.
model PlanLoan {
  id                String             @id @default(cuid())
  householdId       String
  direction         PlanLoanDirection
  mode              PlanLoanMode
  name              String
  /// Con quién: banco, persona, etc.
  counterpart       String?
  categoryId        String?
  currency          Currency           @default(ARS)
  /// FIXED: capital · OPEN: saldo inicial · SCHEDULE: suma de las cuotas.
  principal         Decimal            @db.Decimal(14, 2)
  /// FIXED: cantidad de cuotas.
  installments      Int?
  /// FIXED: cuota del primer mes (después se propone la del mes anterior).
  /// OPEN: pago sugerido por mes.
  installmentAmount Decimal?           @db.Decimal(14, 2)
  /// Interés en % por `interestFrequency` (ej. 3.5 = 3,5 % mensual). Null = sin interés.
  interestRate      Decimal?           @db.Decimal(8, 4)
  interestFrequency PlanFrequency?
  /// Primer mes en que cae una cuota ("YYYY-MM").
  startPeriod       String
  /// Día del mes en que vence la cuota.
  dueDay            Int?
  /// OPEN: fecha límite para saldarla.
  endDate           DateTime?          @db.Date
  isClosed          Boolean            @default(false)
  closedAt          DateTime?
  note              String?
  createdAt         DateTime           @default(now())

  household Household              @relation(fields: [householdId], references: [id])
  category  PlanCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  schedule  PlanLoanScheduleItem[]
  entries   PlanEntry[]

  @@index([householdId])
}

/// SCHEDULE: monto de la cuota de cada mes.
model PlanLoanScheduleItem {
  id     String  @id @default(cuid())
  loanId String
  period String
  amount Decimal @db.Decimal(14, 2)

  loan PlanLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, period])
}

/// Presupuesto mensual por categoría de gasto.
model PlanBudget {
  id          String  @id @default(cuid())
  householdId String
  period      String
  categoryId  String
  amount      Decimal @db.Decimal(14, 2)

  household Household    @relation(fields: [householdId], references: [id])
  category  PlanCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, period, categoryId])
}

/// Compra con tarjeta. Las cuotas se proyectan solas desde `firstPeriod`.
model PlanCardPurchase {
  id           String    @id @default(cuid())
  householdId  String
  cardId       String
  description  String
  categoryId   String?
  currency     Currency  @default(ARS)
  /// Monto total de la compra (se divide en `installments` cuotas iguales).
  amount       Decimal   @db.Decimal(14, 2)
  installments Int       @default(1)
  /// Mes del resumen en que entra la primera cuota ("YYYY-MM").
  firstPeriod  String
  purchaseDate DateTime? @db.Date
  note         String?
  createdAt    DateTime  @default(now())

  household Household     @relation(fields: [householdId], references: [id])
  card      Card          @relation(fields: [cardId], references: [id])
  category  PlanCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([householdId, cardId])
}

/// Resumen de una tarjeta para un mes: lo que hay que pagar.
model PlanCardStatement {
  id           String      @id @default(cuid())
  householdId  String
  cardId       String
  period       String
  dueDate      DateTime?   @db.Date
  totalArs     Decimal     @db.Decimal(14, 2)
  minimumArs   Decimal?    @db.Decimal(14, 2)
  usdAmount    Decimal?    @db.Decimal(14, 2)
  payMode      PlanPayMode @default(TOTAL)
  customAmount Decimal?    @db.Decimal(14, 2)
  isPaid       Boolean     @default(false)
  paidAt       DateTime?
  createdAt    DateTime    @default(now())

  household Household @relation(fields: [householdId], references: [id])
  card      Card      @relation(fields: [cardId], references: [id])

  @@unique([cardId, period])
  @@index([householdId, period])
}

/// Patrimonio: algo que tenés (ASSET) o que debés (DEBT).
model PlanBalanceItem {
  id          String          @id @default(cuid())
  householdId String
  type        PlanBalanceType
  name        String
  currency    Currency        @default(ARS)
  isArchived  Boolean         @default(false)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())

  household Household          @relation(fields: [householdId], references: [id])
  values    PlanBalanceValue[]

  @@index([householdId])
}

/// Saldo de un ítem de patrimonio al cierre de un mes.
model PlanBalanceValue {
  id     String  @id @default(cuid())
  itemId String
  period String
  amount Decimal @db.Decimal(14, 2)

  item PlanBalanceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, period])
}
