// Omero Finance — Prisma Schema v2 (solo Plan simple; la app clásica se borró)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────

model Household {
  id        String        @id @default(cuid())
  name      String
  type      HouseholdType @default(PERSONAL)
  createdAt DateTime      @default(now())

  users       User[]
  invitations HouseholdInvitation[]
  cards       Card[]

  // Plan simple (/plan)
  planMonths         PlanMonth[]
  planCategories     PlanCategory[]
  planRecurrings     PlanRecurring[]
  planEntries        PlanEntry[]
  planBudgets        PlanBudget[]
  planCardPurchases  PlanCardPurchase[]
  planCardStatements PlanCardStatement[]
  planBalanceItems   PlanBalanceItem[]
  planLoans          PlanLoan[]
}

model User {
  id           String   @id @default(cuid())
  householdId  String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MEMBER)
  avatarColor  String   @default("#6366F1")
  createdAt    DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])
  sessions  Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Cards catalog
// ─────────────────────────────────────────────

model Card {
  id          String   @id @default(cuid())
  householdId String
  name        String
  entity      String?
  cardType    String?
  ownerName   String?
  createdAt   DateTime @default(now())

  household      Household           @relation(fields: [householdId], references: [id])
  planPurchases  PlanCardPurchase[]
  planStatements PlanCardStatement[]
}

enum UserRole {
  ADMIN
  MEMBER
}

enum Currency {
  ARS
  USD
}

enum HouseholdType {
  PERSONAL
  SHARED
  ORGANIZATION
  MULTIPLE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model HouseholdInvitation {
  id          String           @id @default(cuid())
  householdId String
  email       String?
  code        String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  household Household @relation(fields: [householdId], references: [id])
}

// ═════════════════════════════════════════════
// Plan simple (/plan) — toda la app.
// El mes se guarda como "YYYY-MM" en `period`.
// ═════════════════════════════════════════════

enum PlanKind {
  INCOME
  EXPENSE
}

enum PlanFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PlanPayMode {
  TOTAL
  MINIMUM
  CUSTOM
}

enum PlanBalanceType {
  ASSET
  DEBT
}

/// OWE = lo debo yo (gasto) · OWED = me lo deben (ingreso).
enum PlanLoanDirection {
  OWE
  OWED
}

/// FIXED = cuota fija × N · SCHEDULE = cuotas cargadas a mano · OPEN = saldo sin cuotas fijas.
enum PlanLoanMode {
  FIXED
  SCHEDULE
  OPEN
}

/// Un mes "iniciado": guarda el tipo de cambio usado para ese mes.
model PlanMonth {
  id          String   @id @default(cuid())
  householdId String
  period      String
  usdRate     Decimal  @db.Decimal(10, 4)
  startedAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])

  @@unique([householdId, period])
}

/// Categorías de ingresos y de gastos. `systemKey = "TDC"` es la línea de
/// tarjetas de crédito: su gasto real sale de los resúmenes, no de movimientos.
model PlanCategory {
  id          String   @id @default(cuid())
  householdId String
  kind        PlanKind
  name        String
  systemKey   String?
  isArchived  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  household       Household          @relation(fields: [householdId], references: [id])
  recurrings      PlanRecurring[]    @relation("PlanRecurringCategory")
  recurringTarget PlanRecurring[]    @relation("PlanRecurringTarget")
  entries         PlanEntry[]        @relation("PlanEntryCategory")
  entryTarget     PlanEntry[]        @relation("PlanEntryTarget")
  budgets         PlanBudget[]
  cardPurchases   PlanCardPurchase[]
  loans           PlanLoan[]

  @@unique([householdId, kind, name])
}

/// La "regla" de un ingreso fijo o gasto fijo: monto por vez + recurrencia.
/// Cada mes genera un PlanEntry (monto × cantidad de veces en el mes).
model PlanRecurring {
  id               String        @id @default(cuid())
  householdId      String
  kind             PlanKind
  name             String
  categoryId       String?
  /// Solo ingresos: categoría de gasto a la que se destina (opcional).
  targetCategoryId String?
  currency         Currency      @default(ARS)
  /// Monto por ocurrencia (por día, por semana, por quincena o por mes).
  amount           Decimal       @db.Decimal(14, 2)
  frequency        PlanFrequency @default(MONTHLY)
  /// Semanal: día de la semana (0 = domingo … 6 = sábado).
  weekday          Int?
  /// Mensual: día del mes en que se cobra / vence (informativo).
  dueDay           Int?
  isActive         Boolean       @default(true)
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())

  household      Household     @relation(fields: [householdId], references: [id])
  category       PlanCategory? @relation("PlanRecurringCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  targetCategory PlanCategory? @relation("PlanRecurringTarget", fields: [targetCategoryId], references: [id], onDelete: SetNull)
  entries        PlanEntry[]

  @@index([householdId, kind])
}

/// Un ingreso o gasto de un mes. Si `recurringId` está presente es un fijo
/// (generado desde la regla); si no, es un movimiento variable.
model PlanEntry {
  id               String    @id @default(cuid())
  householdId      String
  period           String
  kind             PlanKind
  recurringId      String?
  name             String
  categoryId       String?
  targetCategoryId String?
  currency         Currency  @default(ARS)
  amount           Decimal   @db.Decimal(14, 2)
  date             DateTime? @db.Date
  /// Fijos: cobrado / pagado.
  isDone           Boolean   @default(false)
  note             String?
  /// Cuota de un préstamo o deuda (PlanLoan). Uno por préstamo y mes.
  loanId           String?
  /// Parte del monto que es interés (calculado al generar la cuota).
  interestAmount   Decimal?  @db.Decimal(14, 2)
  createdAt        DateTime  @default(now())

  household      Household      @relation(fields: [householdId], references: [id])
  loan           PlanLoan?      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  recurring      PlanRecurring? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  category       PlanCategory?  @relation("PlanEntryCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  targetCategory PlanCategory?  @relation("PlanEntryTarget", fields: [targetCategoryId], references: [id], onDelete: SetNull)

  @@unique([recurringId, period])
  @@unique([loanId, period])
  @@index([householdId, period])
}

/// Préstamo o deuda: lo que debo o lo que me deben.
/// Cada mes iniciado genera un PlanEntry (la cuota) vinculado por `loanId`;
/// al marcar pagadas todas las cuotas (o saldar el saldo) se cierra solo.
model PlanLoan {
  id                String             @id @default(cuid())
  householdId       String
  direction         PlanLoanDirection
  mode              PlanLoanMode
  name              String
  /// Con quién: banco, persona, etc.
  counterpart       String?
  categoryId        String?
  currency          Currency           @default(ARS)
  /// FIXED: capital · OPEN: saldo inicial · SCHEDULE: suma de las cuotas.
  principal         Decimal            @db.Decimal(14, 2)
  /// FIXED: cantidad de cuotas.
  installments      Int?
  /// FIXED: cuota del primer mes (después se propone la del mes anterior).
  /// OPEN: pago sugerido por mes.
  installmentAmount Decimal?           @db.Decimal(14, 2)
  /// Interés en % por `interestFrequency` (ej. 3.5 = 3,5 % mensual). Null = sin interés.
  interestRate      Decimal?           @db.Decimal(8, 4)
  interestFrequency PlanFrequency?
  /// true = `interestRate` es una tasa anual (TNA): por mes se usa 1/12.
  interestAnnual    Boolean            @default(false)
  /// IVA u otro impuesto sobre el interés, en % (ej. 21). Va dentro de la cuota y no baja capital.
  interestTaxPct    Decimal?           @db.Decimal(5, 2)
  /// Primer mes en que cae una cuota ("YYYY-MM").
  startPeriod       String
  /// Día del mes en que vence la cuota.
  dueDay            Int?
  /// OPEN: fecha límite para saldarla.
  endDate           DateTime?          @db.Date
  isClosed          Boolean            @default(false)
  closedAt          DateTime?
  note              String?
  createdAt         DateTime           @default(now())

  household Household              @relation(fields: [householdId], references: [id])
  category  PlanCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  schedule  PlanLoanScheduleItem[]
  balances  PlanLoanBalance[]
  entries   PlanEntry[]

  @@index([householdId])
}

/// SCHEDULE: monto de la cuota de cada mes.
model PlanLoanScheduleItem {
  id     String  @id @default(cuid())
  loanId String
  period String
  amount Decimal @db.Decimal(14, 2)

  loan PlanLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, period])
}

/// Saldo según el banco (o la otra parte) al empezar `period`, antes de la cuota de ese mes.
/// Pisa el saldo calculado: desde ahí la cuenta sigue con las cuotas y el interés.
model PlanLoanBalance {
  id        String   @id @default(cuid())
  loanId    String
  period    String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  loan PlanLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, period])
}

/// Presupuesto mensual por categoría de gasto.
model PlanBudget {
  id          String  @id @default(cuid())
  householdId String
  period      String
  categoryId  String
  amount      Decimal @db.Decimal(14, 2)

  household Household    @relation(fields: [householdId], references: [id])
  category  PlanCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, period, categoryId])
}

/// Compra con tarjeta. Las cuotas se proyectan solas desde `firstPeriod`.
model PlanCardPurchase {
  id           String    @id @default(cuid())
  householdId  String
  cardId       String
  description  String
  categoryId   String?
  currency     Currency  @default(ARS)
  /// Monto total de la compra (se divide en `installments` cuotas iguales).
  amount       Decimal   @db.Decimal(14, 2)
  installments Int       @default(1)
  /// Mes del resumen en que entra la primera cuota ("YYYY-MM").
  firstPeriod  String
  purchaseDate DateTime? @db.Date
  note         String?
  createdAt    DateTime  @default(now())

  household Household     @relation(fields: [householdId], references: [id])
  card      Card          @relation(fields: [cardId], references: [id])
  category  PlanCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([householdId, cardId])
}

/// Resumen de una tarjeta para un mes: lo que hay que pagar.
model PlanCardStatement {
  id           String      @id @default(cuid())
  householdId  String
  cardId       String
  period       String
  dueDate      DateTime?   @db.Date
  totalArs     Decimal     @db.Decimal(14, 2)
  minimumArs   Decimal?    @db.Decimal(14, 2)
  usdAmount    Decimal?    @db.Decimal(14, 2)
  payMode      PlanPayMode @default(TOTAL)
  customAmount Decimal?    @db.Decimal(14, 2)
  isPaid       Boolean     @default(false)
  paidAt       DateTime?
  createdAt    DateTime    @default(now())

  household Household @relation(fields: [householdId], references: [id])
  card      Card      @relation(fields: [cardId], references: [id])

  @@unique([cardId, period])
  @@index([householdId, period])
}

/// Patrimonio: algo que tenés (ASSET) o que debés (DEBT).
model PlanBalanceItem {
  id          String          @id @default(cuid())
  householdId String
  type        PlanBalanceType
  name        String
  currency    Currency        @default(ARS)
  isArchived  Boolean         @default(false)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())

  household Household          @relation(fields: [householdId], references: [id])
  values    PlanBalanceValue[]

  @@index([householdId])
}

/// Saldo de un ítem de patrimonio al cierre de un mes.
model PlanBalanceValue {
  id     String  @id @default(cuid())
  itemId String
  period String
  amount Decimal @db.Decimal(14, 2)

  item PlanBalanceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, period])
}
